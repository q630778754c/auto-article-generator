# 全自动AI内容生产与发布系统 环境变量配置（环境层配置）
# 复制为 .env 后按实际环境填写

# ============ 服务基础 ============
APP_HOST=0.0.0.0
APP_PORT=8000
# 运行时数据目录（数据库/图片/日志/密钥统一落此目录）
DATA_DIR=../data
# 日志级别：DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# ============ 安全 ============
# Fernet 主密钥文件路径（首启自动生成，文件权限600）
SECRET_KEY_FILE=../data/.secret_key
# 管理员账号；ADMIN_PASSWORD 为空则首启随机生成并打印一次
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============ 数据库 ============
# SQLite 数据库文件名（相对 DATA_DIR，留空则用默认 app.db）
DATABASE_URL=app.db

# ============ AI 服务（运行层可在管理后台配置覆盖） ============
# LLM 厂商：deepseek/openai/tongyi/kimi/anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 文生图厂商：tongyi_volc（通义万相/火山方舟）
IMAGE_PROVIDER=tongyi_volc
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# ============ 调度（默认值，可在管理后台热更新） ============
POLL_INTERVAL_SEC=60
PIPELINE_CONCURRENCY=5
DAILY_OUTPUT_LIMIT=50

# ============ 告警渠道 ============
# 企业微信机器人 webhook（可空则禁用）
WECHAT_ROBOT_WEBHOOK=
# 邮件 SMTP 配置（可空则禁用）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ============ 图片存储后端（v2 部署）============
# local: 存本地 DATA_DIR/images（开发/单机）
# bitiful: 存 Bitiful 对象存储（生产/Render推荐）
STORAGE_BACKEND=local
# Bitiful S3兼容端点（如 https://bitiful-east.bitiful.net）
BITIFUL_ENDPOINT=
BITIFUL_ACCESS_KEY=
BITIFUL_SECRET_KEY=
BITIFUL_BUCKET=
# 公共读基础URL（Bitiful控制台分配，如 https://bucket-name.bitiful.net）
BITIFUL_PUBLIC_BASE=

# ============ Cloudflare R2（reserved，预留字段暂未启用）============
# 当前实现仅 local/bitiful；如需 R2 可启用 storage.py 中的预留接口
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ============ 统一管理平台（v2 认证）============
# 基础地址（默认即官方）
UNIFIED_PLATFORM_BASE_URL=https://unified-auth-admin.pages.dev/api
# 应用ID/密钥（必填，未填则自动降级到本地admin）
UNIFIED_PLATFORM_APP_ID=
UNIFIED_PLATFORM_APP_SECRET=

# ============ CORS（前后端分离部署时必填）============
# 允许的前端Origin，多个用逗号分隔（如 https://guoke-web.pages.dev,https://your.domain）
CORS_ALLOWED_ORIGINS=

# ============ 构建版本（CI注入）============
BUILD_VERSION=dev
